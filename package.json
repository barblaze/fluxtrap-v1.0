{
  "name": "fluxtrap",
  "version": "1.0.0",
  "private": true,
  "description": "FLUXTRAP - Masocore Platformer",
  "scripts": {
    "cap:sync": "npx cap sync android",
    "cap:copy": "npx cap copy",
    "cap:build": "npx cap copy && cd android && ./gradlew assembleDebug",
    "cap:release": "npx cap copy && cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/core": "^6.2.1",
    "@capacitor/splash-screen": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1"
  }
}
